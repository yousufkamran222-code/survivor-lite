extends Node
## Sound effects and music (autoload "Sfx"). Everything is generated by
## tools/build_assets.py into assets/processed/sfx/ and /music/. A small
## player pool plus per-sound rate limits keeps big fights from turning into
## noise. Volumes are applied per player (not with extra audio buses: buses
## created at runtime are silent in the web build's audio path). Also owns
## vibration (respects the Vibration setting).

const SOUNDS := {
	"shoot": preload("res://assets/processed/sfx/shoot.wav"),
	"hit": preload("res://assets/processed/sfx/hit.wav"),
	"kill": preload("res://assets/processed/sfx/kill.wav"),
	"kill2": preload("res://assets/processed/sfx/kill2.wav"),
	"pickup": preload("res://assets/processed/sfx/pickup.wav"),
	"level_up": preload("res://assets/processed/sfx/level_up.wav"),
	"hurt": preload("res://assets/processed/sfx/hurt.wav"),
	"nova": preload("res://assets/processed/sfx/nova.wav"),
	"chain": preload("res://assets/processed/sfx/chain.wav"),
	"death": preload("res://assets/processed/sfx/death.wav"),
	"boss": preload("res://assets/processed/sfx/boss.wav"),
	"click": preload("res://assets/processed/sfx/click.wav"),
	"dash": preload("res://assets/processed/sfx/dash.wav"),
	"elite": preload("res://assets/processed/sfx/elite.wav"),
	"vacuum": preload("res://assets/processed/sfx/vacuum.wav"),
	"heal": preload("res://assets/processed/sfx/heal.wav"),
	"bomb": preload("res://assets/processed/sfx/bomb.wav"),
	"chest": preload("res://assets/processed/sfx/chest.wav"),
	"evolve": preload("res://assets/processed/sfx/evolve.wav"),
	"claim": preload("res://assets/processed/sfx/claim.wav"),
	"convert": preload("res://assets/processed/sfx/convert.wav"),
	"upgrade": preload("res://assets/processed/sfx/upgrade.wav"),
	"deny": preload("res://assets/processed/sfx/deny.wav"),
}
const MIN_GAP_MS := {"shoot": 70, "hit": 45, "kill": 40, "kill2": 40, "pickup": 35, "chain": 80, "click": 40, "convert": 90}
const VOLUME_DB := {"shoot": -14.0, "hit": -12.0, "kill": -9.0, "kill2": -9.0, "pickup": -13.0, "chain": -10.0}

const MUSIC := {
	"menu": preload("res://assets/processed/music/menu.wav"),
	"run_base": preload("res://assets/processed/music/run_base.wav"),
	"run_drive": preload("res://assets/processed/music/run_drive.wav"),
}
const MUSIC_DB := -8.0  # music sits under the effects
const DUCK_DB := -7.0

var _players: Array[AudioStreamPlayer] = []
var _last := {}
var _next := 0
var _music_a: AudioStreamPlayer  # menu loop, or the run's base layer
var _music_b: AudioStreamPlayer  # the run's drive layer (faded by intensity)
var _track := ""
var _intensity := 0.0  # target 0..1
var _drive := 0.0  # smoothed
var _duck := 0.0  # 0..1, decays
var _sfx_db := 0.0  # from the Effects volume
var _music_db := 0.0  # from the Music volume (+ MUSIC_DB)
var _sfx_on := true
var _music_on := true


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in 10:
		var p := AudioStreamPlayer.new()
		add_child(p)
		_players.append(p)
	_music_a = AudioStreamPlayer.new()
	_music_b = AudioStreamPlayer.new()
	add_child(_music_a)
	add_child(_music_b)
	apply_settings()


## Re-reads the Settings volumes (0..1) and the mute flag.
func apply_settings() -> void:
	_sfx_on = not Save.muted and Save.sfx_volume > 0.001
	_music_on = not Save.muted and Save.music_volume > 0.001
	_sfx_db = linear_to_db(maxf(Save.sfx_volume, 0.0001))
	_music_db = linear_to_db(maxf(Save.music_volume, 0.0001)) + MUSIC_DB
	_apply_music_volume()


func _apply_music_volume() -> void:
	var base := _music_db + DUCK_DB * _duck if _music_on else -80.0
	_music_a.volume_db = base
	_music_b.volume_db = base + linear_to_db(maxf(_drive, 0.001)) if _track == "run" else -80.0


## "menu" or "run" (two synced layers); "" stops the music.
func play_music(track: String) -> void:
	if track == _track:
		return
	_track = track
	_music_a.stop()
	_music_b.stop()
	match track:
		"menu":
			_music_a.stream = MUSIC.menu
			_music_a.play()
		"run":
			_music_a.stream = MUSIC.run_base
			_music_b.stream = MUSIC.run_drive
			_drive = 0.0
			_music_a.play()
			_music_b.play()  # same length and tempo: they stay in sync
	_apply_music_volume()


## How intense the run is right now (0..1): fades the drive layer in.
func set_intensity(x: float) -> void:
	_intensity = clampf(x, 0.0, 1.0)


## Briefly dips the music under a big sound (boss, bomb, death, ...).
func duck() -> void:
	_duck = 1.0


func _process(delta: float) -> void:
	var changed := false
	if _track == "run" and not is_equal_approx(_drive, _intensity):
		_drive = move_toward(_drive, _intensity, delta * 0.5)
		changed = true
	if _duck > 0.0:
		_duck = maxf(0.0, _duck - delta * 2.5)
		changed = true
	if changed:
		_apply_music_volume()


func vibrate(ms: int) -> void:
	if Save.vibration:
		Input.vibrate_handheld(ms)


func play(name: String, pitch_jitter: float = 0.08, pitch: float = 1.0) -> void:
	if not _sfx_on or not SOUNDS.has(name):
		return
	if name in ["boss", "bomb", "death", "evolve"]:
		duck()
	var now := Time.get_ticks_msec()
	if now - int(_last.get(name, -100000)) < int(MIN_GAP_MS.get(name, 0)):
		return
	_last[name] = now
	var p := _players[_next]
	_next = (_next + 1) % _players.size()
	p.stream = SOUNDS[name]
	p.volume_db = float(VOLUME_DB.get(name, -6.0)) + _sfx_db
	p.pitch_scale = pitch + randf_range(-pitch_jitter, pitch_jitter)
	p.play()
