      {"id": "antibiotics", "name": "ANTIBIOTICS", "desc": "Dodge the sweeping beam", "s": 6, "width": 150, "speed": 260, "germ_dmg_frac": 0.6, "elite_mult": 0.2, "boss_mult": 0.05, "player_dmg": 18},
